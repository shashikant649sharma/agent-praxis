# Agent Praxis Environment Configuration Template
# Copy this file to .env and insert your API credentials.
# NOTE: Never commit your actual .env file or API keys to version control!

# AgentRouter / Multi-provider gateway
AGENTROUTER_API_KEY=your_agentrouter_api_key_here
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1

# Groq Cloud API
GROQ_API_KEY=your_groq_api_key_here

# Baseten Live Endpoint (for Meta Muse Spark Open / frontier models)
BASETEN_API_KEY=your_baseten_api_key_here
BASETEN_API_URL=https://model-xxxxxx.api.baseten.co/environments/production/predict

# Meta Llama API / Stack
META_API_KEY=your_meta_api_key_here
META_API_URL=https://api.llama-api.com/chat/completions

# Agent Praxis Local/Remote Evaluator Server
PRAXIS_API_TOKEN=your_praxis_api_token_here
PRAXIS_SERVER_PORT=8000
