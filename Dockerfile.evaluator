# Evaluator image — the trusted side of the benchmark.
#
# Holds the environment implementations, the hidden ground-truth state models,
# and the scoring logic. The agent never gets this image.
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies if any
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install project
COPY . .
RUN pip install --no-cache-dir -e . \
    && pip install --no-cache-dir fastapi uvicorn

# Run unprivileged.
RUN useradd --create-home --uid 10002 evaluator \
    && chown -R evaluator:evaluator /app
USER evaluator

EXPOSE 8000

# Start the evaluator server
CMD ["python", "-m", "agent_praxis.server"]
